node_modules
.next
out
.env*.local
.DS_Store
*.log
next-env.d.ts

# Sécurité : ignorer tout fichier d'env
.env
.env.*
!.env.local.example

# Skills installes localement (npx skills add)
.agents/*
!.agents/rules/
!.agents/workflows/

# Fichiers temporaires d'audit (créés par les relecteurs, jamais versionnés)
.audit-*
*.audit.mjs
.next-prod
.demo-compte.local

# Secret de webhook Stripe, ecrit par scripts/stripe-verifier.mjs
.stripe-webhook.local

# Fichiers de valeurs temporaires poses sur Vercel
.stripe-taxe.local

scripts/_*.tmp.mjs

# Clé privée des sauvegardes — jamais versionnée (scripts/cle-sauvegarde.mjs)
cle-sauvegarde.key.pem
sauvegardes/

# Service worker généré au build par @serwist/next (app/sw.ts → public/sw.js) — jamais versionné
public/sw.js
public/sw.js.map
public/swe-worker-*.js
public/swe-worker-*.js.map

# Certificat auto-signé du faux service de push (scripts/push-e2e.mjs) — jamais versionné
scripts/.certs-test/

# Sorties du smoke Android (captures, logcat) : artefact CI, jamais versionnées
mobile/smoke/

# Sorties de compilation Android et cache TypeScript : lourds, régénérables, jamais versionnés.
presti-debug-apk/
presti-debug-apk.zip
*.apk
tsconfig.tsbuildinfo

# intermédiaires de la vidéo de présentation (scripts/promo-video.mjs)
.promo-tmp/

# (Les vidéos de publication vivaient ici jusqu'au 2026-09-10 ; elles sont maintenant rendues
# directement dans `publications/`, ignoré plus bas. Règle conservée : une exécution d'un ancien
# script remettrait des MP4 ici, et ils n'ont rien à faire dans le dépôt.)
public/promo/pub-*/

# Le dossier de travail des publications (scripts/publications-ranger.mjs).
# Il est ENTIÈREMENT dérivé : les textes sont découpés de plans/publications-10.md, les vidéos
# rendues depuis promo-src/hf/publications.mjs. Le versionner ferait un deuxième original du texte
# — celui qu'on corrigerait par erreur, sans que rien ne le signale — et ajouterait 68 Mo de MP4
# dérivés d'une liste de plans de 300 lignes. Une commande le refait entièrement.
publications/

# aperçus vidéo téléchargés pour les images-clés (droits MotionSites) : jamais versionnés
.orchestre/preuves/refs/*.mp4

# Captures des juges des vagues de retouche de la démo (017-*) : des centaines de Mo par vague ; on ne suit que les
# captures clés rangées dans <vague>/cles/, le reste reste sur la machine qui a jugé.
.orchestre/preuves/017-*/*
!.orchestre/preuves/017-*/cles

# Photos candidates et originaux téléchargés pour choisir (plusieurs dizaines de Mo) : ils restent sur la machine.
# Le 14/09/2026, 57 Mo d'originaux sont partis dans le commit 80472e8 parce qu'un dossier de preuves a été ajouté entier.
.orchestre/preuves/*/photos/
**/originaux/

# Dossier de travail des agents (sauvegardes d'images, essais) : jamais suivi.
.orchestre/travail/
# Captures clés des vagues de la démo : seules les versions JPG allégées sont suivies (les PNG pèsent des dizaines de Mo).
.orchestre/preuves/017-*/cles/*.png

# Moment signature (020) : images et films de travail, jamais versionnés (planches et instants en JPEG, JSON et scripts oui)
.orchestre/preuves/020-*/**/*.png
.orchestre/preuves/020-*/**/*.mp4
.orchestre/preuves/021-*/**/*.png
.orchestre/preuves/021-*/**/*.mp4
.orchestre/preuves/021-*/**/*.avif
.orchestre/preuves/021-*/**/*.jpg

# Copies de travail des agents Claude (workflows isolés, 27/09) : jamais dans le dépôt ni dans les paquets de l’usine
.claude/worktrees/

# Données de prospects (audit de confidentialité du 04/10) : adresses e-mail, téléphones, listes de contacts. Elles vivent dans
# presti-ops/ et presti-secrets/ (hors dépôt) ; leurs copies sous docs/contexte-cloud/ sont parties dans git le 30/09 (0fcf0bb0,
# 9f5198f7) et en ont été retirées du suivi le 04/10 (les fichiers restent sur le disque, l'historique les garde : dépôt privé).
# Règles ancrées exprès : scripts/fixtures/…/saas/Prospection/ contient des jeux d'essai FICTIFS, à garder suivis.
docs/contexte-cloud/presti-ops/prospection/
docs/contexte-cloud/SaaS/Prospection/
docs/contexte-cloud/presti-secrets/prospection/
reprise-cloud/prospection/

# Secrets et clés : jamais versionnés (audit de confidentialité du 04/10, « .gitignore incomplet »)
.codex/auth.json
*.pem
!cle-sauvegarde.pub.pem
*.p12
**/firebase/compte-de-service.json
/fix.js
