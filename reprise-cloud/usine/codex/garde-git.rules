# Garde-fous posés par Claude Code le 24/09/2026 sur décision de Benj (D3 du plan de l'écosystème).
# Un « git restore » lancé par un agent a effacé trois jours de travail le 13/09/2026.
prefix_rule(
    pattern = ["git", "restore"],
    decision = "forbidden",
    justification = "Interdit aux agents : efface du travail non commité (incident du 13/09/2026).",
)
prefix_rule(
    pattern = ["git", "checkout", ["--", "."]],
    decision = "forbidden",
    justification = "Interdit aux agents : écrase des fichiers modifiés.",
)
prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Interdit aux agents : efface du travail non commité.",
)
prefix_rule(
    pattern = ["git", "clean"],
    decision = "forbidden",
    justification = "Interdit aux agents : supprime des fichiers non suivis.",
)
prefix_rule(
    pattern = ["git", "push", ["--force", "-f", "--force-with-lease"]],
    decision = "forbidden",
    justification = "Interdit aux agents : réécrit l'historique distant.",
)
prefix_rule(
    pattern = ["git", "stash", ["drop", "clear"]],
    decision = "forbidden",
    justification = "Interdit aux agents : perd du travail mis de côté.",
)
prefix_rule(
    pattern = ["rm", ["-rf", "-fr"]],
    decision = "forbidden",
    justification = "Interdit aux agents : suppression récursive forcée.",
)
