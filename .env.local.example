# Modèle des variables d'environnement de Presti.
# Copie ce fichier en « .env.local » et remplis les vraies valeurs.
# ⚠️ Ne JAMAIS committer .env.local (il est ignoré par git).
# Sur Vercel : recopie ces mêmes variables dans Project Settings → Environment Variables.

# --- Supabase (public, côté navigateur) ---
NEXT_PUBLIC_SUPABASE_URL=https://TON-PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TA_CLE_ANON_PUBLIC

# --- Secrets (côté serveur uniquement) ---
SUPABASE_SERVICE_ROLE_KEY=TA_CLE_SERVICE_SECRETE
ANTHROPIC_API_KEY=TA_CLE_ANTHROPIC
RESEND_API_KEY=TA_CLE_RESEND

# --- Optionnel : protège le cron des relances sur Vercel ---
# Si tu définis CRON_SECRET, Vercel l'envoie automatiquement au cron.
CRON_SECRET=UNE_LONGUE_CHAINE_ALEATOIRE
