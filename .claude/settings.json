{
  "model": "opusplan",
  "effortLevel": "high",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-C:/Users/benja/Documents/presti}/scripts/hooks/read-garde.mjs\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|mcp__(?!cerveau__|ccd_|terminal__|visualize__|Claude_Browser__|mcp-registry__).+",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-C:/Users/benja/Documents/presti}/scripts/verifier-outils-obligatoires.mjs\"",
            "timeout": 30,
            "onFailure": "block",
            "statusMessage": "Vérification de n8n, Hermes et Orca"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-C:/Users/benja/Documents/presti}/scripts/hooks/garde-agents-orca.mjs\"",
            "timeout": 15,
            "statusMessage": "Garde des sessions lancées par Orca"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR:-C:/Users/benja/Documents/presti}/scripts/hooks/contexte-fond.mjs\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(git restore:*)",
      "Bash(git checkout --:*)",
      "Bash(git checkout .:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git stash drop:*)",
      "Bash(git stash clear:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)"
    ]
  }
}
