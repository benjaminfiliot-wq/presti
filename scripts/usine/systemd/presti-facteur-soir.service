[Unit]
Description=Rejugement du soir du Facteur sur l'usine

[Service]
Type=oneshot
User=agents
WorkingDirectory=/srv/presti-agents
Environment=CODEX_LANCEUR=/usr/local/bin/presti-ia-modele
ExecStart=/usr/bin/node scripts/usine/avec-coffre.mjs PRESTI_JETON_FACTEUR -- /usr/bin/node --import ./scripts/ts-loader.mjs scripts/agents/passes-modele.mjs --agent=facteur --soir
TimeoutStartSec=14min
MemoryMax=512M
