[Unit]
Description=Presti livreur de sites sur l'usine

[Service]
Type=oneshot
User=agents
WorkingDirectory=/srv/presti-agents
Environment=PRESTI_HOTE=usine
Environment=PLAYWRIGHT_BROWSERS_PATH=/srv/playwright
Environment=CODEX_LANCEUR=/usr/local/bin/presti-ia-modele
ExecStart=/usr/bin/node scripts/usine/avec-coffre.mjs PRESTI_JETON_LIVREUR_USINE -- /usr/bin/node scripts/usine/tourneur.mjs --capacite=livraison --une-passe --base=https://prestiapp.fr --travail=/home/agents/travail/usine
TimeoutStartSec=55min
MemoryMax=4G
Nice=10
