[Unit]
Description=Presti atelier des maquettes sur l'usine

[Service]
Type=oneshot
User=agents
WorkingDirectory=/srv/presti-agents
Environment=PRESTI_HOTE=usine
Environment=PRESTI_URL=https://prestiapp.fr
Environment=PLAYWRIGHT_BROWSERS_PATH=/srv/playwright
ExecStart=/usr/bin/node scripts/usine/avec-coffre.mjs PRESTI_JETON_ATELIER -- /usr/bin/node --import ./scripts/ts-loader.mjs scripts/agents/atelier-maquettes.mjs --une-passe
StandardOutput=append:/home/agents/travail/atelier/atelier.log
StandardError=inherit
TimeoutStartSec=45min
MemoryMax=4G
Nice=10
