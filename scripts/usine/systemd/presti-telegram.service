[Unit]
Description=Presti pont Telegram sur l'usine (long polling, aucun port ouvert)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agents
WorkingDirectory=/srv/presti-agents
ExecStart=/usr/bin/node scripts/usine/avec-coffre.mjs TELEGRAM_BOT_TOKEN PRESTI_JETON_TELEGRAM TELEGRAM_CHAT_ID TELEGRAM_CODE_APPAIRAGE -- /usr/bin/node scripts/usine/telegram.mjs --service --base=https://prestiapp.fr
Restart=always
RestartSec=60
MemoryMax=192M

[Install]
WantedBy=multi-user.target
