[Unit]
Description=Presti, Contrôleur qualité des sites : une passe en lecture seule sur les sites livrés, jamais d'écriture sur un site ni de formulaire soumis (026-247, 026-251)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=agents
Group=agents
WorkingDirectory=/srv/presti-agents
Environment=PRESTI_HOTE=usine
Environment=PRESTI_URL=https://prestiapp.fr
Environment=PLAYWRIGHT_BROWSERS_PATH=/srv/playwright
ExecStart=/usr/bin/node scripts/usine/avec-coffre.mjs PRESTI_JETON_QUALITE -- /usr/bin/node --import ./scripts/ts-loader.mjs scripts/agents/controleur-qualite.mjs --une-passe
TimeoutStartSec=30min
MemoryMax=2G
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes
