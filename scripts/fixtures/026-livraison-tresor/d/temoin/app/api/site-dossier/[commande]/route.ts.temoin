// TÉMOIN du lot D (fiche 026-026) : la route de 026-028, jamais livrée (voir lib/siteDossier.ts.temoin).
// GET /api/site-dossier/<commande>?j=<jeton> — l'archive du site, ou la même 404 neutre.
import { servirDossier } from '@/lib/siteDossier'

export const runtime = 'nodejs'
export const dynamic = 'force-dynamic'

export async function GET(req: Request, ctx: { params: Promise<{ commande: string }> }) {
  const { commande } = await ctx.params
  return servirDossier(req, commande)
}
