// Témoin « après » de FS-6 (scripts/formulaire-site-qa.mjs, fiche 025-01 point 5 ; état attendu de la fiche 025-03), écrit
// par Claude Code le 24/09. CE N'EST PAS LA ROUTE DE PRESTI : c'est app/api/leads/route.ts de 1620723, raccourci après la
// branche « pause » (l'IA, les crédits et les e-mails, que FS-6 ne lit pas, sont remplacés par un commentaire), avec le seul
// changement que 025-03 doit faire : après l'échec de la recherche par slug, l'ANCIENNE adresse (0051, lib/slugRedirect.ts:6)
// est essayée avant le 404 — un site statique généré avant un changement d'adresse envoie toujours l'ancien slug.
// Suffixe .temoin : un .ts ici serait compilé par `npm run typecheck` (tsconfig inclut **/*.ts). Le juge le copie, sans le
// suffixe, dans .orchestre/travail/formulaire-site-qa/temoin/app/api/leads/route.ts (non compilé : .orchestre/ est ignoré).
// Ajout du 25/09 (FS-12, fiche 025-22, défaut D01) : un champ `commande` (l'identifiant de la commande de site) fait retrouver
// l'artisan par sites_commandes.artisan_id ; refus 404 si la commande n'est pas en ligne, si l'artisan est nul, purgé
// (supprime-…) ou en suppression ; jamais de repli par le slug quand la commande est donnée. Sans ce champ : le slug, comme avant.
import { NextResponse } from 'next/server'
import { supabaseAdmin } from '@/lib/supabaseAdmin'
import { suspensionEnCours, MESSAGE_PUBLIC_INDISPONIBLE } from '@/lib/suspension'
import { qualifyLead } from '@/lib/ai'
import { getIp, isBanned, recordAbuse, ipPseudonyme } from '@/lib/security'
import { consommerLimite } from '@/lib/limites'
import { artisanParAncienSlug } from '@/lib/slugRedirect'

const MAX = { slug: 80, contact: 200, nom: 120, message: 5000 }
const MAX_LEADS_PAR_IP = 6
const COLONNES = 'id, nom, metier, ton_style, email, is_founder, leads_pause, services, zone_intervention, bio, tva_regime, assurance_nom, plan'
const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i
const clip = (v: unknown, n: number): string | null => {
  if (typeof v !== 'string') return null
  const t = v.trim()
  return t ? t.slice(0, n) : null
}

export async function POST(req: Request) {
  try {
    const body = await req.json().catch(() => null)
    const slug = clip(body?.slug, MAX.slug)
    const contact = clip(body?.contact, MAX.contact)
    const nom_prospect = clip(body?.nom_prospect, MAX.nom)
    const message = clip(body?.message, MAX.message)
    const variant = body?.variant === 'A' || body?.variant === 'B' ? body.variant : null
    const deferContact = body?.deferContact === true
    // La commande de site (FS-12) : donnée, elle décide seule ; illisible, la demande est refusée (jamais le slug à sa place).
    const commandeDonnee = body?.commande !== undefined && body?.commande !== null && body?.commande !== ''
    const commande = commandeDonnee && typeof body.commande === 'string' ? body.commande.trim() : null

    if ((!slug && !commandeDonnee) || (!contact && !deferContact) || (deferContact && !message)) {
      return NextResponse.json({ error: 'Slug et contact requis' }, { status: 400 })
    }
    if (commandeDonnee ? !commande || !UUID.test(commande) : !/^[a-z0-9-]{1,80}$/.test(slug ?? '')) {
      return NextResponse.json({ error: 'Lien invalide' }, { status: 400 })
    }

    const ip = getIp(req)

    // Anti-hacker : IP bannie → on refuse tout, immédiatement.
    if (await isBanned(ip)) {
      return NextResponse.json({ error: 'Accès refusé.' }, { status: 403 })
    }

    // Honeypot anti-bot : champ caché qui doit rester vide. Rempli = bot → abus + drop silencieux.
    if (typeof body?.website === 'string' && body.website.trim()) {
      await recordAbuse(ip, 'honeypot /api/leads')
      return NextResponse.json({ ok: true })
    }

    if (ip !== 'unknown' && !(await consommerLimite(`leads:ip:${ip}`, MAX_LEADS_PAR_IP, 10 * 60))) {
      await recordAbuse(ip, 'flood /api/leads')
      return NextResponse.json({ error: 'Trop de demandes. Réessayez dans quelques minutes.' }, { status: 429 })
    }

    // 0) Un site commandé envoie l'identifiant de sa commande (FS-12) : l'artisan est celui de la commande, jamais celui qui
    // porte aujourd'hui le slug (un compte purgé libère son slug, un inconnu peut le reprendre — D01). Refus si la commande
    // n'est pas en ligne, si son artisan a été effacé (artisan_id nul), purgé (supprime-…) ou en suppression.
    let artisanDeLaCommande: Record<string, unknown> | null = null
    if (commandeDonnee) {
      const { data: c, error: cErr } = await supabaseAdmin.from('sites_commandes').select('artisan_id, etat').eq('id', commande).maybeSingle()
      if (cErr) {
        console.error('[leads] lookup commande:', cErr.message)
        return NextResponse.json({ error: 'Service momentanément indisponible' }, { status: 500 })
      }
      if (c && c.etat === 'en_ligne' && c.artisan_id) {
        const r = await supabaseAdmin.from('artisans').select(`${COLONNES}, slug, suppression_demandee_le`).eq('id', c.artisan_id).maybeSingle()
        if (r.error) {
          console.error('[leads] lookup artisan (commande):', r.error.message)
          return NextResponse.json({ error: 'Service momentanément indisponible' }, { status: 500 })
        }
        if (r.data && !String(r.data.slug ?? '').startsWith('supprime-') && !r.data.suppression_demandee_le) artisanDeLaCommande = r.data
      }
      if (!artisanDeLaCommande) return NextResponse.json({ error: 'Artisan introuvable' }, { status: 404 })
    }

    // 1) Retrouver l'artisan à partir de son slug… (jamais un compte purgé : lib/purgeComptes.ts lui donne l'adresse supprime-…,
    // et sa page ne prend plus de demande — une demande acceptée là serait perdue ; témoin de FS-11, relecture du 24/09)
    let { data: artisan, error: aErr } = artisanDeLaCommande ? { data: artisanDeLaCommande, error: null } : await supabaseAdmin
      .from('artisans')
      .select(COLONNES)
      .eq('slug', slug)
      .not('slug', 'like', 'supprime-%')
      .maybeSingle()

    if (aErr) {
      console.error('[leads] lookup artisan:', aErr.message)
      return NextResponse.json({ error: 'Service momentanément indisponible' }, { status: 500 })
    }
    // … ou de son ANCIENNE adresse (0051) : le site statique d'un artisan qui a changé de slug l'envoie encore.
    if (!artisan) {
      const actuel = await artisanParAncienSlug(slug)
      // l'ancienne adresse d'un compte purgé (le trigger de 0051 l'a gardée dans slugs_anciens) ne mène plus nulle part
      if (actuel && !actuel.slug.startsWith('supprime-')) {
        const r = await supabaseAdmin.from('artisans').select(COLONNES).eq('slug', actuel.slug).maybeSingle()
        if (r.error) {
          console.error('[leads] lookup artisan (ancienne adresse):', r.error.message)
          return NextResponse.json({ error: 'Service momentanément indisponible' }, { status: 500 })
        }
        artisan = r.data
      }
    }
    if (!artisan) return NextResponse.json({ error: 'Artisan introuvable' }, { status: 404 })
    if (await suspensionEnCours(artisan.id)) return NextResponse.json({ error: MESSAGE_PUBLIC_INDISPONIBLE }, { status: 410 })

    const qualif = qualifyLead(message, artisan.metier)

    // 2) Enregistrer le lead (chemin critique : on ne le perd jamais)
    const { data: lead, error: lErr } = await supabaseAdmin
      .from('leads')
      .insert({
        artisan_id: artisan.id,
        nom_prospect,
        contact,
        message,
        canal: 'formulaire',
        statut: 'nouveau',
        urgence: qualif.urgence,
        type_chantier: qualif.type_chantier,
        ab_variant: variant,
        ip: ipPseudonyme(ip),
      })
      .select('id, token')
      .single()

    if (lErr) {
      console.error('[leads] insert lead:', lErr.message)
      return NextResponse.json({ error: 'Enregistrement impossible' }, { status: 500 })
    }

    // Mode PAUSE : le lead est TOUJOURS sauvé, mais aucune réponse IA ni email ne part.
    if (artisan.leads_pause === true) {
      if (message) {
        await supabaseAdmin.from('messages').insert({ lead_id: lead.id, sens: 'in', type: 'manuel', contenu: message })
      }
      return NextResponse.json({ ok: true, leadId: lead.id, token: lead.token, paused: true, reply: null })
    }

    // (témoin : la suite de la route réelle — photos, plafond par artisan, décision de réponse, crédits, IA, e-mails,
    // relances — n'est pas lue par FS-6 et n'est pas reprise ici.)
    return NextResponse.json({ ok: true, leadId: lead.id, token: lead.token, reply: null })
  } catch (e) {
    console.error('[leads] erreur inattendue:', e)
    return NextResponse.json({ error: 'Service momentanément indisponible' }, { status: 500 })
  }
}
