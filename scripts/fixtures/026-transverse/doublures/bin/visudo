#!/usr/bin/env bash
# Doublure de visudo pour usine-durcie-qa (026-194) : consigne ses arguments dans $JUGE_JOURNAL, rien de plus que ce qu ecrit le juge.
set -u
journal() { local o="$1"; shift; { printf "%s" "$o"; for a in "$@"; do printf " %s" "$a"; done; printf "\n"; } >> "$JUGE_JOURNAL"; }
journal visudo "$@"
fichier=""
prev=""
for a in "$@"; do
  case "$prev" in -cf|-fc|-f) fichier="$a" ;; esac
  prev="$a"
done
if [ -n "$fichier" ]; then
  n=$(ls "$JUGE_JOURNAL".visudo.* 2>/dev/null | wc -l)
  cp "$fichier" "$JUGE_JOURNAL.visudo.$((n + 1))"
  if [ -n "${JUGE_VISUDO_ECHEC:-}" ]; then echo "visudo : erreur de syntaxe (doublure du juge)" >&2; exit 1; fi
fi
exit 0
