#!/usr/bin/env bash
# Doublure de getent pour usine-durcie-qa (026-194) : consigne ses arguments dans $JUGE_JOURNAL, rien de plus que ce qu ecrit le juge.
set -u
journal() { local o="$1"; shift; { printf "%s" "$o"; for a in "$@"; do printf " %s" "$a"; done; printf "\n"; } >> "$JUGE_JOURNAL"; }
journal getent "$@"
base="${1:-}"; nom="${2:-}"
case "$base" in passwd|group) grep "^$nom:" "$JUGE_SYSTEME/etc/$base" || exit 2 ;; *) exit 2 ;; esac
exit 0
