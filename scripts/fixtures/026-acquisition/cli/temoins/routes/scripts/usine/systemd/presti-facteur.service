# TÉMOIN du juge routes-acquisition-qa (026-037, RB-18) : l'unité presti-facteur de 026-094, point 2 quater.
[Unit]
Description=Presti : passes du modèle (facteur) sur l'usine

[Service]
Type=oneshot
User=agents
WorkingDirectory=/srv/presti-agents
Environment=CODEX_LANCEUR=/usr/local/bin/presti-ia-modele
ExecStart=/usr/bin/node scripts/usine/avec-coffre.mjs PRESTI_JETON_FACTEUR -- /usr/bin/node --import ./scripts/ts-loader.mjs scripts/agents/passes-modele.mjs --agent=facteur
TimeoutStartSec=14min
MemoryMax=512M
