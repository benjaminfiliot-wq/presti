{
  "_": "Contrat machine de la production sur l'usine Oracle (fiche 026-052, écrit par Claude Code), copie du juge : usine-sql-qa.mjs (026-054), usine-routes-qa.mjs (026-056) et usine-production-qa.mjs (026-057, 026-143) le lisent. La source du code des limites est lib/agents/usineLimites.json (026-056), que les juges comparent à « limites ». Une autre capacité s'ajouterait par une entrée de « capacites » et de « limites », sans changer le tourneur.",
  "source": "026-052 « Le contrat de l'usine » ; 026-054, 026-056, 026-057 (revue transverse du 25/09 : le fabricant ne reçoit aucune clé, seulement CODEX_LANCEUR)",
  "capacites": {
    "livraison": {
      "agent": "livreur_usine",
      "jeton": "PRESTI_JETON_LIVREUR_USINE",
      "type": "livrer_site",
      "cle": "livrer_site:<uuid de la commande>",
      "charge": { "cles": ["commande", "essai"], "obligatoires": ["commande"], "types": { "commande": "uuid", "essai": "vrai" } },
      "entree": { "prefixe": "usine/<tache>/entree/", "fichiers": ["commande.json", "les photos de l'artisan"], "max": 50 },
      "sortie": { "racines": ["site/", "rapport-qa.json"], "manifeste": "manifeste.json" },
      "minutes": 25,
      "env": ["CODEX_LANCEUR"],
      "coffre_fabricant": [],
      "commande_reelle": ["{node}", "--import", "./scripts/ts-loader.mjs", "scripts/livrer-site.mjs", "--usine", "--entree={entree}", "--sortie={sortie}"]
    }
  },
  "limites": {
    "livraison": {
      "entrees_max": 50,
      "fichiers_max": 300,
      "octets_fichier_max": 5242880,
      "octets_total_max": 41943040,
      "types": ["text/html", "text/css", "text/javascript", "application/javascript", "application/json", "image/webp", "image/avif", "image/jpeg", "image/png", "image/svg+xml", "font/woff2", "text/plain", "application/xml", "text/xml"]
    }
  },
  "extensions": {
    ".html": ["text/html"], ".htm": ["text/html"], ".css": ["text/css"], ".js": ["text/javascript", "application/javascript"], ".mjs": ["text/javascript", "application/javascript"],
    ".json": ["application/json"], ".webmanifest": ["application/json"], ".webp": ["image/webp"], ".avif": ["image/avif"], ".jpg": ["image/jpeg"], ".jpeg": ["image/jpeg"],
    ".png": ["image/png"], ".svg": ["image/svg+xml"], ".woff2": ["font/woff2"], ".txt": ["text/plain"], ".xml": ["application/xml", "text/xml"]
  },
  "nom_fichier": { "expression": "^[a-z0-9][a-z0-9._/-]{0,119}$", "interdits": ["..", "//", "\\", "caractère de contrôle", "/ en tête"], "max_signes": 120 },
  "manifeste": { "forme": "{ fichiers: [{ nom, type }] }", "regle": "seuls les fichiers listés partent ; un fichier non listé est ignoré" },
  "bucket": {
    "id": "usine", "name": "usine", "public": false, "file_size_limit": 8388608,
    "allowed_mime_types": ["text/html", "text/css", "text/javascript", "application/javascript", "application/json", "image/webp", "image/avif", "image/jpeg", "image/png", "image/svg+xml", "font/woff2", "text/plain", "application/xml", "text/xml"],
    "politiques_storage_objects": 0,
    "chemins": { "entree": "usine/<tache>/entree/<nom>", "sortie": "usine/<tache>/sortie/<nom>" }
  },
  "migration": {
    "suffixe": "_usine_socle.sql", "numero": "0110", "fichier": "supabase/migrations/0110_usine_socle.sql",
    "jumeau": "supabase/migrations/_A_COLLER_sql_editor_0110.sql", "nu": "supabase/migrations/_A_COLLER_sql_editor_0110_NU.sql",
    "controle": "supabase/controles/0110_usine_socle.sql", "essai_a_sec": ".orchestre/preuves/026-054/essai-a-sec.txt",
    "scenario": "scripts/fixtures/026/usine-production/essai-0110.sql",
    "apres": "select to_regprocedure('public.ops_tache_detenue(text,uuid)') is null and not exists (select 1 from storage.buckets where id = 'usine') as rien_ne_reste;"
  },
  "fonction": {
    "nom": "ops_tache_detenue", "schema": "public",
    "params": [["p_agent", "text"], ["p_id", "uuid"]],
    "rend": [["id", "uuid"], ["type", "text"], ["cle_idempotence", "text"], ["capacite", "text"], ["charge", "jsonb"], ["bail_jusqua", "timestamptz"]],
    "filtre": ["id = p_id", "agent = p_agent", "statut = 'bail'", "bail_jusqua > now()"],
    "table": "ops.taches", "volatilite": "stable", "securite": "security definer", "revoque": ["public", "anon", "authenticated"], "accorde": ["service_role"]
  },
  "graines": [
    { "nom": "usine", "libelle": "Surveillance de l'usine", "capacites": ["surveillance"], "types_crees": [], "tables": ["evenements", "decisions"], "periode_minutes": 30, "debit_minute": 30, "quota_creations_jour": 2, "plafond_euros_jour": 0 },
    { "nom": "livreur_usine", "libelle": "Livreur de sites (usine)", "capacites": ["livraison"], "types_crees": [], "tables": ["taches", "evenements"], "periode_minutes": 60, "debit_minute": 30, "quota_creations_jour": 0, "plafond_euros_jour": 0 }
  ],
  "graines_intouchables": ["atelier_maquettes", "livreur", "chef"],
  "colonnes_intouchables": ["jeton_hash", "en_pause", "battement_le"],
  "routes": {
    "fichiers": ["app/api/agents/usine/entree/route.ts", "app/api/agents/usine/depot/route.ts"],
    "depot_lib": "lib/agents/usineDepot.ts", "limites_lib": "lib/agents/usineLimites.json",
    "drapeau": "busAgents", "table": "taches", "corps_max_octets": 16384, "signature_lecture_s": 900,
    "entree": { "corps": { "tache": "uuid" }, "reponse": "{ tache, entrees: [{ nom, url, octets }] }", "trop_d_entrees": 409 },
    "depot": { "corps": { "tache": "uuid", "fichiers": "[{ nom, octets, type, sha256 }]" }, "reponse": "{ depots: [{ nom, url, jeton }] }", "total_trop_gros": 413 },
    "tache_non_detenue": { "status": 404, "meme_corps": true, "cas": ["inconnue", "tenue par un autre agent", "bail expiré"] },
    "capacite_hors_limites": 403,
    "stockage": { "total_octets": 1073741824, "seuil": 0.6, "au_dela": 507, "mesure_en_erreur": 503 },
    "interdits_dans_les_routes": ["supabaseAdmin", "ANTHROPIC", "acq_", "ops_decision_trancher", "ops_interrupteur_poser"]
  },
  "bus": {
    "battement": "POST /api/agents/battement",
    "prendre": "POST /api/agents/taches/prendre → 200 { tache: {id, type, cle_idempotence, objet, capacite, charge, tentatives, bail_jusqua, origine_id, profondeur} | null }",
    "en_pause": { "status": 423, "corps": { "error": "Refusé par le bus.", "code": "agent_en_pause" }, "note": "la route rend le code d'erreur ops:agent_en_pause sans le préfixe « ops: » (lib/agents/bus.ts, STATUT_ERREUR)" },
    "rendre": "POST /api/agents/taches/<id>/rendre { resultat: 'faite' | 'echec', preuve_url?, erreur? } ; faite exige une preuve qui commence par supabase://",
    "evenements": "POST /api/agents/evenements { type, objet?, resume, tache? }",
    "entree": "POST /api/agents/usine/entree",
    "depot": "POST /api/agents/usine/depot ; puis un PUT par fichier sur url, au Content-Type du fichier, sans le jeton de l'agent"
  },
  "fin": { "resultat": "faite", "preuve_url": "supabase://usine/<tache>/sortie/" },
  "tourneur": {
    "fichier": "scripts/usine/tourneur.mjs", "table": "scripts/usine/capacites.mjs",
    "regle_table": "la commande du fabricant se lit dans CAPACITES[<capacite>].commande, exporté par ./capacites.mjs ; le juge la remplace dans une copie de la table (jamais par une variable d'environnement)",
    "env_du_tourneur": ["PATH", "HOME", "LANG", "TZ", "PLAYWRIGHT_BROWSERS_PATH"],
    "env_du_fabricant": ["PATH", "HOME", "LANG", "TZ", "PLAYWRIGHT_BROWSERS_PATH", "CODEX_LANCEUR"],
    "verrou": "<travail>/tourneur-<capacite>.verrou", "verrou_minutes": 60,
    "journal": { "fichier": "<travail>/tourneur-<capacite>.jsonl", "passage": ["le", "capacite", "taches", "duree_s"], "tache": ["le", "tache", "code", "etape", "octets", "duree_s"] },
    "memoire_min_octets": 1610612736, "disque_min_octets": 2147483648, "max_defaut": 2, "passage_max_minutes": 50, "put_essais_max": 3,
    "erreurs": ["capacite", "charge", "entree", "fabrication:delai", "fabrication:code <n>", "sortie:manifeste", "sortie:nom", "sortie:lien", "sortie:type", "sortie:taille", "sortie:secret", "depot:stockage", "depot"],
    "codes": { "ok": 0, "deja_en_cours": 0, "ressources": 0, "en_pause": 0, "bus_401_5xx_reseau": 1, "appel_invalide_jeton_absent": 2, "bus_429": 3 }
  },
  "unites": {
    "presti-atelier.service": {
      "Service": {
        "Type": "oneshot", "User": "agents", "WorkingDirectory": "/srv/presti-agents",
        "Environment": ["PRESTI_HOTE=usine", "PRESTI_URL=https://prestiapp.fr", "PLAYWRIGHT_BROWSERS_PATH=/srv/playwright"],
        "ExecStart": "/usr/bin/node scripts/usine/avec-coffre.mjs PRESTI_JETON_ATELIER -- /usr/bin/node --import ./scripts/ts-loader.mjs scripts/agents/atelier-maquettes.mjs --une-passe",
        "StandardOutput": "append:/home/agents/travail/atelier/atelier.log", "StandardError": "inherit",
        "TimeoutStartSec": "45min", "MemoryMax": "4G", "Nice": "10"
      },
      "interdits": ["EnvironmentFile", "PassEnvironment", "CODEX_LANCEUR"]
    },
    "presti-atelier.timer": { "Timer": { "OnCalendar": "*:0/15", "RandomizedDelaySec": "60", "Persistent": "false", "Unit": "presti-atelier.service" }, "Install": { "WantedBy": "timers.target" } },
    "presti-livreur.service": {
      "Service": {
        "Type": "oneshot", "User": "agents", "WorkingDirectory": "/srv/presti-agents",
        "Environment": ["PRESTI_HOTE=usine", "PLAYWRIGHT_BROWSERS_PATH=/srv/playwright", "CODEX_LANCEUR=/usr/local/bin/presti-ia-modele"],
        "ExecStart": "/usr/bin/node scripts/usine/avec-coffre.mjs PRESTI_JETON_LIVREUR_USINE -- /usr/bin/node scripts/usine/tourneur.mjs --capacite=livraison --une-passe --base=https://prestiapp.fr --travail=/home/agents/travail/usine",
        "TimeoutStartSec": "55min", "MemoryMax": "4G", "Nice": "10"
      },
      "interdits": ["EnvironmentFile", "PassEnvironment", "PRESTI_URL", "StandardOutput=append:"]
    },
    "presti-livreur.timer": { "Timer": { "OnCalendar": "*:0/10", "RandomizedDelaySec": "60", "Persistent": "false", "Unit": "presti-livreur.service" }, "Install": { "WantedBy": "timers.target" } }
  },
  "doc": {
    "fichier": "docs/agents/usine-production.md",
    "sections": ["Ce qui tourne sur l'usine", "L'atelier des maquettes", "Les tâches du livreur", "L'entrée", "La sortie et le manifeste", "Ce que le serveur fait ensuite", "GitHub Actions en repli", "Reprise par le poste", "Ce qui ne va jamais sur l'usine"],
    "contenus": {
      "L'atelier des maquettes": ["026-097", "app/api/usine/atelier", "atelier_maquettes", "PRESTI_JETON_ATELIER"],
      "Ce que le serveur fait ensuite": ["essai: true"],
      "Reprise par le poste": ["node scripts/usine/tourneur.mjs --capacite=livraison --une-passe --base=https://prestiapp.fr", "PRESTI_JETON_LIVREUR_USINE", "node --import ./scripts/ts-loader.mjs scripts/agents/atelier-maquettes.mjs --une-passe", "PRESTI_JETON_ATELIER"],
      "Ce qui ne va jamais sur l'usine": ["clé de service", "Stripe", "Anthropic", ".env.local"]
    }
  }
}
