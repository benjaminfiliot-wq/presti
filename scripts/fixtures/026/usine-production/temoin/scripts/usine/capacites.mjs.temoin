// TÉMOIN (026-052) — une mise en œuvre de référence de scripts/usine/capacites.mjs (fiche 026-057), écrite par Claude Code
// pour prouver que scripts/usine-production-qa.mjs sait réussir, et, sabotée, échouer. Ce n'est pas le livrable.
//
// La table des capacités du tourneur : une capacité = un agent, son jeton, le type de ses tâches, son délai, les variables
// (non secrètes) passées au fabricant, et la commande du fabricant ({node}, {entree}, {sortie} remplacés au lancement).
export const CAPACITES = {
  livraison: {
    agent: 'livreur_usine', jeton: 'PRESTI_JETON_LIVREUR_USINE', type: 'livrer_site', minutes: 25, env: ['CODEX_LANCEUR'],
    commande: ['{node}', '--import', './scripts/ts-loader.mjs', 'scripts/livrer-site.mjs', '--usine', '--entree={entree}', '--sortie={sortie}'],
  },
}

const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i
/** Le schéma de la charge d'une capacité : clés exactes, types exacts. → null si conforme, sinon la raison. */
export const SCHEMAS = {
  livraison: (c) => {
    if (!c || typeof c !== 'object' || Array.isArray(c)) return 'objet attendu'
    for (const k of Object.keys(c)) if (!['commande', 'essai'].includes(k)) return `clé en trop : ${k}`
    if (typeof c.commande !== 'string' || !UUID.test(c.commande)) return 'commande : un uuid'
    if ('essai' in c && c.essai !== true) return 'essai : true seulement'
    return null
  },
}
