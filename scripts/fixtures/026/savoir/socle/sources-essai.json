  "reclassement": {
    "coordonnees_min": 5,
    "note": "Un fichier public ou interne qui porte 5 coordonnées ou plus (adresses e-mail, numéros français, SIREN/SIRET valides selon Luhn — comptées avant caviardage) part au compartiment prospects, avec reclasse: true dans son entrée de manifeste ; jamais l'inverse (un fichier de la liste prospects reste prospects)."
  },
  "caviardage": {
    "_note": "S'applique aux classes public et interne seulement (jamais à prospects, jamais caviardé). Les règles s'appliquent dans l'ordre (adresse, puis numéro, puis siren) ; chaque remplacement compte pour 1 dans caviardages. Le compte, fait sur le texte brut, sert aussi au reclassement.",
    "classes": [
      "public",
      "interne"
    ],
    "regles": [
      {
        "type": "adresse",
        "regex": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
        "flags": "g",
        "remplace_par": "[adresse]"
      },
      {
        "type": "numero",
        "regex": "(?<!\\d)(?:\\+33[\\s.]?|0)[1-9](?:[\\s.]?\\d{2}){4}(?!\\d)",
        "flags": "g",
        "remplace_par": "[numéro]",
        "note": "numéro français, 9 chiffres ou plus une fois les séparateurs (espaces, points) retirés, avec ou sans +33 ; jamais au milieu d'une suite de chiffres."
      },
      {
        "type": "siren",
        "regex": "(?<!\\d)\\d{3}[ .\\u00a0]?\\d{3}[ .\\u00a0]?\\d{3}(?:[ .\\u00a0]?\\d{5})?(?!\\d)",
        "flags": "g",
        "remplace_par": "[siren]",
        "luhn": true,
        "note": "candidat 9 (SIREN) ou 14 (SIRET) chiffres, séparateurs permis (123 456 782, 987 654 324 00001), retenu seulement si ses chiffres valident Luhn ; sinon laissé tel quel."
      }
    ]
  },
  "moteurs": {
    "_note": "28/09 : relecture, interne jamais vers un moteur gratuit — corrige la rédaction du 27/09, qui laissait general (public ET interne) partir vers « tout moteur, gratuit compris ». Ce champ fait foi pour toute fiche de la couche Savoir qui envoie du texte de general à un moteur (026-232 auto-recherche, 026-234 auto-apprentissage, 026-238 auto-réflexion).",
