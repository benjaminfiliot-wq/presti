[Unit]
Description=Presti — réunion d'équipage du chef (GPT-6 sol)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=agents
Group=agents
WorkingDirectory=/srv/presti-agents
Environment=PRESTI_HOTE=usine
Environment=ORCHESTRE_CODEX_BIN=/usr/local/bin/presti-chef-modele
ExecStart=/usr/bin/node scripts/usine/avec-coffre.mjs PRESTI_JETON_CHEF -- /usr/bin/node scripts/chef/reunion.mjs --base=https://prestiapp.fr --codex=/usr/local/bin/presti-chef-modele
TimeoutStartSec=25min
