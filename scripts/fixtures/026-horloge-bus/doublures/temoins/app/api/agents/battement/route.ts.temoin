// TÉMOIN (026-038) — l'implémentation de référence de app/api/agents/battement/route.ts (fiche 026-042), sur laquelle
// agents-routes-qa --temoin doit être VERT. Ce n'est pas le code livré : 026-042 écrit le sien.
import { NextResponse } from 'next/server'
import { actif } from '@/lib/flags'
import { authAgent, reponseRefusAgent } from '@/lib/agents/garde'
import { ops_battement } from '@/lib/agents/bus'

export const runtime = 'nodejs'
export const dynamic = 'force-dynamic'

const refus = (r: unknown): r is { status: number; code: string; error: string } => !!r && typeof r === 'object' && 'error' in r

// POST /api/agents/battement — sans corps : « je suis vivant ».
export async function POST(req: Request) {
  if (!actif('busAgents')) return NextResponse.json({ error: 'Introuvable.' }, { status: 404 })
  const agent = await authAgent(req)
  if (refus(agent)) return reponseRefusAgent(agent)
  const r = await ops_battement({ p_nom: agent.nom })
  if (!r.ok) return NextResponse.json({ error: 'Refusé par le bus.', code: r.code }, { status: r.status })
  return NextResponse.json({ battement_le: r.data })
}
