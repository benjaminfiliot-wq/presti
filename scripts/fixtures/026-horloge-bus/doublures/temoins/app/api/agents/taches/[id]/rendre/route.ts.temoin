// TÉMOIN (026-038) — l'implémentation de référence de app/api/agents/taches/[id]/rendre/route.ts (fiche 026-042), sur
// laquelle agents-routes-qa --temoin doit être VERT. Ce n'est pas le code livré : 026-042 écrit le sien.
import { NextResponse } from 'next/server'
import { actif } from '@/lib/flags'
import { authAgent, exigerTable, reponseRefusAgent } from '@/lib/agents/garde'
import { ops_tache_rendre } from '@/lib/agents/bus'

export const runtime = 'nodejs'
export const dynamic = 'force-dynamic'

const MAX = 16 * 1024
const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i
const refus = (r: unknown): r is { status: number; code: string; error: string } => !!r && typeof r === 'object' && 'error' in r
const erreur = (error: string, status: number, code?: string) => NextResponse.json(code ? { error, code } : { error }, { status })

// POST /api/agents/taches/<id>/rendre — { resultat: 'faite' | 'echec', preuve_url?, erreur? }
export async function POST(req: Request, ctx: { params: Promise<{ id: string }> }) {
  if (!actif('busAgents')) return erreur('Introuvable.', 404)
  const agent = await authAgent(req)
  if (refus(agent)) return reponseRefusAgent(agent)
  const { id } = await ctx.params
  if (!UUID.test(id)) return erreur('Tâche inconnue.', 404)
  const brut = await req.text()
  if (Buffer.byteLength(brut) > MAX) return erreur('Corps trop grand (16 Ko au plus).', 413)
  let b: Record<string, unknown>
  try { b = JSON.parse(brut) } catch { return erreur('JSON invalide.', 400) }
  if (!b || typeof b !== 'object' || Array.isArray(b)) return erreur('Un objet JSON attendu.', 400)
  if (b.resultat !== 'faite' && b.resultat !== 'echec') return erreur('resultat : faite ou echec.', 400)
  if (b.preuve_url !== undefined && b.preuve_url !== null && typeof b.preuve_url !== 'string') return erreur('preuve_url : un texte.', 400)
  if (b.erreur !== undefined && b.erreur !== null && typeof b.erreur !== 'string') return erreur('erreur : un texte.', 400)
  const t = await exigerTable(agent, 'taches')
  if (t) return reponseRefusAgent(t)
  const r = await ops_tache_rendre({ p_agent: agent.nom, p_id: id, p_resultat: b.resultat, p_preuve_url: (b.preuve_url as string) ?? null, p_erreur: (b.erreur as string) ?? null })
  if (!r.ok) return erreur('Refusé par le bus.', r.status, r.code)
  return NextResponse.json({ statut: r.data })
}
