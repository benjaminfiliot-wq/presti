// TÉMOIN (026-038) — l'implémentation de référence de lib/agents/bus.ts (fiche 026-040), sur laquelle agents-garde-qa --temoin
// doit être VERT. Ce n'est pas le code livré : 026-040 écrit le sien. Suffixe .temoin : hors de `npm run typecheck` du dépôt.
//
// Une fonction par fonction SQL des contrats 0097 et 0098, du MÊME nom, qui reçoit un objet aux clés `p_…` du contrat et
// envoie exactement ces clés (null pour un paramètre absent : aucune fonction du contrat n'a de défaut). Chacune rend
// { ok: true, data } ou { ok: false, code, status } ; le texte brut de Postgres ne sort jamais d'ici (console.error seulement).
import { supabaseAdmin } from '@/lib/supabaseAdmin'

export type ResultatBus<T = any> = { ok: true; data: T } | { ok: false; code: string; status: number }

export const STATUT_ERREUR: Record<string, number> = {
  options: 400, defaut: 400, echeance: 400, choix: 400, resume: 400, preuve: 400, jeton_format: 400, purge: 400, type_argent: 400, vt: 400,
  type: 403, auteur: 403, opposition: 403, capacite: 403,
  agent_inconnu: 404, origine: 404, interrupteur: 404,
  profondeur: 409, sous_taches: 409, bail_perdu: 409, deja_tranchee: 409, jeton_deja_pris: 409, statut: 409,
  '90_jours': 409, '72_heures': 409, '3_messages': 409, relance_sans_contact: 409,
  agent_en_pause: 423, pause_generale: 423, quota_absent: 423,
  quota: 429,
}

async function appeler(fonction: string, noms: string[], p: Record<string, unknown>): Promise<ResultatBus> {
  const args: Record<string, unknown> = {}
  for (const n of noms) args[n] = p[n] === undefined ? null : p[n]
  let r: { data: unknown; error: { message?: string; code?: string } | null; status: number }
  try {
    r = (await supabaseAdmin.rpc(fonction, args)) as typeof r
  } catch (e) {
    console.error(`[bus] ${fonction} : base injoignable :`, e instanceof Error ? e.message : e)
    return { ok: false, code: 'base_injoignable', status: 503 }
  }
  if (!r.error) return { ok: true, data: r.data }
  const m = /^ops:([a-z0-9_]+)$/.exec(String(r.error.message ?? '').trim())
  if (m) return { ok: false, code: m[1], status: STATUT_ERREUR[m[1]] ?? 500 }
  console.error(`[bus] ${fonction} :`, r.error.message)
  if (r.status === 0) return { ok: false, code: 'base_injoignable', status: 503 }
  return { ok: false, code: 'erreur', status: 500 }
}

export const ops_agent_enregistrer = (p: { p_nom: string | null; p_libelle: string | null; p_capacites: string[] | null; p_types_crees: string[] | null; p_tables: string[] | null; p_periode_minutes: number | null; p_debit_minute: number | null; p_quota_creations_jour: number | null; p_plafond_euros_jour: number | null }) => appeler('ops_agent_enregistrer', ['p_nom','p_libelle','p_capacites','p_types_crees','p_tables','p_periode_minutes','p_debit_minute','p_quota_creations_jour','p_plafond_euros_jour'], p)
