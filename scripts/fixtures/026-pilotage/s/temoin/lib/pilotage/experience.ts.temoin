// TÉMOIN du lot s (026-067) : implémentation de référence de lib/pilotage/experience.ts (026-070), écrite par Claude Code
// pour prouver que station-logique-qa sait rendre 0. Ce n'est pas le module livré. Pur.
export const DUREE_EXPERIENCE = 30
const EUROS = new Intl.NumberFormat('fr-FR', { maximumFractionDigits: 2 })
const eur = (n: number) => `${EUROS.format(n)} €`

export type LigneExperience = {
  ventes?: number | null; statut?: string | null; jour?: number | null; gains_eur?: number | null; budget_eur?: number | null; titre?: string | null
}

export function etatExperience(ligne: LigneExperience | null | undefined, _maintenant?: Date) {
  const l = ligne ?? {}
  const statut = l.statut ?? null
  const jour = Math.min(DUREE_EXPERIENCE, Math.max(1, Math.floor(Number.isFinite(l.jour) ? Number(l.jour) : 1)))
  const gains = Number.isFinite(l.gains_eur) ? Number(l.gains_eur) : 0
  const budget = Number.isFinite(l.budget_eur) ? Number(l.budget_eur) : 0
  const base = { titre: l.titre ?? 'Expérience', jour: statut ? jour : 0, sur: DUREE_EXPERIENCE, gains, budget, statut }
  if (!statut) {
    const texte = (l.ventes ?? 0) > 0
      ? 'Aucune expérience en cours. Lancer une expérience se décide avec Benj (R13).'
      : 'Aucune expérience avant la première vente (décision R13).'
    return { ...base, barre: null, texte }
  }
  if (statut === 'en_cours') return { ...base, barre: `J${jour}/${DUREE_EXPERIENCE} · ${eur(gains)}`, texte: `Jour ${jour} sur ${DUREE_EXPERIENCE}.` }
  if (statut === 'arretee_auto') return { ...base, barre: null, texte: 'Arrêtée seule à J30 : rien rapporté.' }
  if (statut === 'gagnante') return { ...base, barre: null, texte: `J30 atteint : ${eur(gains)} gagnés. À toi de décider de la suite.` }
  if (statut === 'arretee') return { ...base, barre: null, texte: 'Arrêtée par Benj.' }
  return { ...base, barre: null, texte: 'État de l’expérience inconnu.' }
}
