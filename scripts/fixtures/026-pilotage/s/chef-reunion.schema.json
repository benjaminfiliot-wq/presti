{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Plan de réunion du Chef — schéma d'essai de station-reunion-qa (026-067), au contrat de 026-103",
 "description": "Le schéma que station-reunion-qa passe par --schema. Bornes : 1 à 5 lignes de 1 à 140 signes sans @, sans 9 chiffres de suite, sans http ; un objectif ou null ; 3 idées au plus, clé chef:<AAAA-MM-JJ>:idee-…, exactement les options lancer et reporter, défaut reporter, portée aucune, 0 centime. Sous-ensemble de JSON Schema : type, properties, required, additionalProperties, items, minItems, maxItems, minLength, maxLength, pattern, enum, const, oneOf, minimum, format date-time.",
 "type": "object",
 "additionalProperties": false,
 "required": ["lignes", "objectif", "idees"],
 "properties": {
  "lignes": {
   "type": "array", "minItems": 1, "maxItems": 5,
   "items": { "type": "string", "minLength": 1, "maxLength": 140, "pattern": "^(?![\\s\\S]*(?:@|[0-9]{9}|http))[\\s\\S]+$" }
  },
  "objectif": {
   "oneOf": [
    { "type": "null" },
    {
     "type": "object", "additionalProperties": false, "required": ["libelle", "mesure", "cible"],
     "properties": {
      "libelle": { "type": "string", "minLength": 5, "maxLength": 80 },
      "mesure": { "enum": [null, "encaisse_eur", "oui", "contacts_froids", "sites_en_ligne"] },
      "cible": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }] }
     }
    }
   ]
  },
  "idees": {
   "type": "array", "maxItems": 3,
   "items": {
    "type": "object", "additionalProperties": false,
    "required": ["cle_idempotence", "question", "contexte", "options", "option_defaut", "portee", "montant_cents", "echeance"],
    "properties": {
     "cle_idempotence": { "type": "string", "pattern": "^chef:\\d{4}-\\d{2}-\\d{2}:idee-[a-z0-9-]{3,75}$" },
     "question": { "type": "string", "minLength": 1, "maxLength": 200 },
     "contexte": { "type": "string", "maxLength": 600 },
     "options": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
       "type": "object", "additionalProperties": false, "required": ["cle", "libelle", "recommandee"],
       "properties": { "cle": { "enum": ["lancer", "reporter"] }, "libelle": { "type": "string", "minLength": 1, "maxLength": 80 }, "recommandee": { "type": "boolean" } }
      }
     },
     "option_defaut": { "const": "reporter" },
     "portee": { "const": "aucune" },
     "montant_cents": { "const": 0 },
     "echeance": { "type": "string", "format": "date-time" }
    }
   }
  }
 }
}
