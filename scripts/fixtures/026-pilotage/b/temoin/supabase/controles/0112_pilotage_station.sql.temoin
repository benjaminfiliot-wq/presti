select 'les quatorze fonctions de la station existent (attendu : oui)' as quoi,
       case when (select count(*) from pg_proc p join pg_namespace n on n.oid = p.pronamespace
                   where n.nspname = 'public' and p.proname in ('station_consigne_transmettre', 'station_reunion_ouvrir', 'station_reunion_clore',
                     'station_reunion_abandonner', 'station_reunions_echues_abandonner', 'station_experience_lancer', 'station_experience_arreter',
                     'station_experiences_echues_arreter', 'station_pause_par_agent', 'station_consigne_par_agent', 'station_reunion_chiffres',
                     'station_reunion_lire', 'station_objectif_actif', 'station_experience_etat')) = 14
            then 'oui' else 'NON (anormal)' end as resultat
union all
select 'security definer (prosecdef) et search_path (proconfig) (attendu : oui)',
       case when not exists (select 1 from pg_proc p join pg_namespace n on n.oid = p.pronamespace
                              where n.nspname = 'public' and p.proname like 'station\_%' and (not p.prosecdef or p.proconfig is null))
            then 'oui' else 'NON (anormal)' end
union all
select 'anon et authenticated sans exécution, service_role avec (attendu : oui)',
       case when not exists (select 1 from pg_proc p join pg_namespace n on n.oid = p.pronamespace
                              where n.nspname = 'public' and p.proname like 'station\_%'
                                and (has_function_privilege('anon', p.oid, 'execute') or has_function_privilege('authenticated', p.oid, 'execute')
                                     or not has_function_privilege('service_role', p.oid, 'execute')))
            then 'oui' else 'NON (anormal)' end
union all
select 'ops.reunions et ops.experiences sous RLS (relrowsecurity), sans politique (pg_policies) (attendu : oui)',
       case when (select count(*) from pg_class c join pg_namespace n on n.oid = c.relnamespace
                   where n.nspname = 'ops' and c.relname in ('reunions', 'experiences') and c.relrowsecurity) = 2
             and not exists (select 1 from pg_policies where schemaname = 'ops' and tablename in ('reunions', 'experiences'))
            then 'oui' else 'NON (anormal)' end
union all
select 'graine pont_telegram {notifier,pause,consigne}, plafond 0 (attendu : oui)',
       case when exists (select 1 from ops.agents a where a.nom = 'pont_telegram' and a.capacites @> array['notifier', 'pause', 'consigne']
                           and cardinality(a.capacites) = 3 and a.plafond_euros_jour = 0)
            then 'oui' else 'NON (anormal)' end
union all
select 'les deux passages sont dans cron.job (attendu : oui)',
       case when (select count(*) from cron.job where jobname in ('station-reunions-echues', 'station-experiences-echues')) = 2
            then 'oui' else 'NON (anormal)' end;
