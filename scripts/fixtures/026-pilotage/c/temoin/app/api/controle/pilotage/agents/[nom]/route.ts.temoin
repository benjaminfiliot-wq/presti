// app/api/controle/pilotage/agents/[nom]/route.ts — IMPLÉMENTATION DE RÉFÉRENCE du lot b (fiche 026-066) de la route de 026-074
// qui met un agent en pause ou le reprend, sous reconfirmation securite : le témoin de pilotage-gestes-qa.
import { NextResponse } from 'next/server'
import { actif } from '@/lib/flags'
import { estDirection, estRefus, reponseRefus, exigerDomaine, domaineRefuse } from '@/lib/direction/garde'
import { exigerReconfirmation } from '@/lib/direction/reconfirmation'
import { journaliser, refusJournal } from '@/lib/direction/journal'
import { supabaseAdmin } from '@/lib/supabaseAdmin'

export const runtime = 'nodejs'
export const dynamic = 'force-dynamic'

const NOM = /^[a-z0-9_]{2,40}$/

export async function POST(req: Request, ctx: { params: Promise<{ nom: string }> }) {
  if (!actif('pilotage')) return NextResponse.json({ error: 'Introuvable.' }, { status: 404 })
  const f = await estDirection(req)
  if (estRefus(f)) return reponseRefus(f)
  const domaine = exigerDomaine(f, 'securite', 'ecrire')
  if (domaineRefuse(domaine)) return reponseRefus(domaine)
  const { nom } = await ctx.params
  if (!NOM.test(nom)) return NextResponse.json({ error: 'Agent introuvable.' }, { status: 404 })
  const refus = await exigerReconfirmation(req, f.uid, 'securite')
  if (refus) return refus
  const corps = (await req.json().catch(() => null)) as { pause?: unknown; motif?: unknown } | null
  if (typeof corps?.pause !== 'boolean') return NextResponse.json({ error: 'pause : true ou false.' }, { status: 400 })
  const motif = typeof corps.motif === 'string' && corps.motif.trim() ? corps.motif.trim() : 'Pause depuis la station'
  if (motif.length < 3 || motif.length > 200) return NextResponse.json({ error: 'Le motif fait de 3 à 200 signes.' }, { status: 400 })
  const journal = await journaliser({ acteur: f, action: 'agent_pause', cible_type: 'agent', cible_id: nom, apres: { nom, pause: corps.pause }, reconfirme: true }, req)
  if (!journal) return refusJournal()
  const r = await supabaseAdmin.rpc('ops_agent_pause', { p_nom: nom, p_pause: corps.pause, p_motif: motif })
  if (r.error) {
    if (r.error.message.includes('ops:agent_inconnu')) return NextResponse.json({ error: 'Agent introuvable.' }, { status: 404 })
    return NextResponse.json({ error: "Rien n'a été fait." }, { status: 503 })
  }
  return NextResponse.json({ message: corps.pause ? `${nom} est en pause.` : `${nom} reprend.` })
}
