'use client'
// TÉMOIN du lot c (026-104) : la Salle des envois de référence (026-120, voie gratuite ; gestes du fondateur de 026-117),
// écrite par Claude Code pour prouver que pilotage-ecran-qa sait rendre 0. Ce n'est pas l'écran livré. Aucun bouton ni
// lien d'envoi : les agents envoient ; le fondateur n'a que ses gestes, sous mot de passe, dans GestesEnvoi.
import Resume, { Contenu, useVue } from './Resume'
import { GestesEnvoi } from '../Gestes'
import type { PropsSalle } from '../Panneaux'

const PASTILLE: Record<string, string> = { pass: 'PASS', refus: 'REFUS' }

export default function Envois({ role, equipage, visible, cle }: PropsSalle) {
  const [vue] = useVue(['/api/controle/station?vue=salle&salle=envois'], 30_000, visible)
  return (
    <>
      <Resume cle={cle} equipage={equipage} role={role} visible={visible} vue={vue} />
      <Contenu rep={vue} source="Salle des envois">{(v) => (
        <div>
          <p data-palier className="mc-mono">{v.palier ?? '—'}</p>
          {v.vide ? <p data-vide-envois>{v.vide}</p> : (
            <>
              {(v.parCanal as any[]).map((c) => (
                <div key={c.canal} data-canal={c.canal}>
                  {c.libelle ?? c.canal} · <span className="mc-mono">{c.texte}</span> · <span data-sante-canal={c.sante}>{c.sante}</span>
                  {c.raisons?.length ? <span className="mc-petit"> ({c.raisons.join(', ')})</span> : null}
                </div>
              ))}
              {(v.parTechnologie as any[]).map((t) => (
                <div key={t.technologie} data-technologie={t.technologie}>
                  {t.technologie} · {t.envois} envois · {t.echecs_affilee} échecs d’affilée · <span data-etat-technologie={t.etat}>{t.etat === 'pause' ? 'en pause' : 'active'}</span>{t.motif ? <span className="mc-petit"> · {t.motif}</span> : null}
                </div>
              ))}
              {(v.envois as any[]).map((e) => (
                <div key={e.id} data-envoi={e.id}>
                  {e.metier ?? ''} · {e.commune ?? ''} · {e.canal} · {e.type}
                  {' '}{(['j1', 'j3', 'second'] as const).map((k) => <span key={k} data-verdict={k} data-valeur-verdict={e.verdicts?.[k] ?? 'attente'} className="mc-petit"> {k === 'second' ? '2e juge' : k.toUpperCase()} {e.verdicts?.[k] ? PASTILLE[e.verdicts[k]] ?? e.verdicts[k] : '…'}</span>)}
                </div>
              ))}
              {(v.anomalies as any[]).map((a) => <div key={a.id} data-anomalie className="mc-panne">{a.texte}</div>)}
              <p data-rejets className="mc-mono">Rejets {v.rejets}</p>
            </>
          )}
          {role === 'direction' ? <GestesEnvoi gestes={v.gestes} canaux={v.parCanal} /> : null}
        </div>
      )}</Contenu>
    </>
  )
}
