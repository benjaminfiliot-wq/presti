// Le chargeur de thème : SEUL appel réseau du moteur. Le préfixe est fixe et la clé vient d'une liste fermée.
import type { Theme } from '../types'

export const CLES_THEME = ['station', 'vaisseau', 'essai'] as const
export type CleTheme = (typeof CLES_THEME)[number]

/** Une clé de la liste fermée, sinon « station » : rien d'autre ne sort de ce module vers l'adresse. */
export const cleValide = (x: unknown): CleTheme => CLES_THEME.find((c) => c === x) ?? 'station'

const bon = (t: Theme | null): t is Theme =>
  !!t && typeof t === 'object' && Number(t.grille?.largeur) > 0 && Number(t.grille?.hauteur) > 0 && Number(t.grille?.pas) > 0
  && Array.isArray(t.emplacements) && Array.isArray(t.avatars) && Array.isArray(t.defauts) && !!t.palette && !!t.coursives && !!t.tapis

export async function chargerTheme(cle: CleTheme): Promise<Theme> {
  const r = await fetch(`/station/themes/${cle}/theme.json`, { cache: 'no-store', credentials: 'omit' })
  if (!r.ok) throw new Error(`thème « ${cle} » introuvable (${r.status})`)
  const t = (await r.json()) as Theme | null
  if (!bon(t)) throw new Error(`thème « ${cle} » illisible`)
  return t
}
