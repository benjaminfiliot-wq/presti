        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "elements": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "string",
              "maxLength": 60
            }
          },
          "confiance": {
            "type": "string",
            "enum": [
              "faible",
              "moyenne",
              "bonne"
            ]
          },
          "chiffrage": {
            "type": "null"
          }
        }
