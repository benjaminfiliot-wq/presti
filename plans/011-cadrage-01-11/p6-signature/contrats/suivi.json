        "objet_id"
      ],
      "maj_le": "défaut now() à l’écriture"
    },
    "conversation": {
      "table": "messages",
      "lu_par": "historiqueRelances : messages.select('sent_at, etat').eq('lead_id').eq('type','relance').eq('sens','out') (hors etat proposition ou rejete)",
      "colonnes": [
        "lead_id",
        "sens",
        "type",
        "contenu"
      ],
      "sent_at": "défaut now() à l’écriture"
    }
  },
