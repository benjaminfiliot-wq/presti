{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "tache": "036-001",
  "source": "plans/011-cadrage-01-11/p6-signature/premiere-reponse.md, ligne 036-001 et § 3",
  "regle": "Hors contrat = rejet (statut « rejete »), une ligne de journal, rien ne part. Toute requête filtre sur artisan_id (« Supabase account » passe outre la RLS).",
  "titre": "presti-cerveau@1 — ce que le Cerveau lit, et comment il route",
  "routes": {
    "demande_recue": "accueil",
    "devis_a_preparer": "devis",
    "relance_due": "suivi",
    "facture_a_emettre": "facturation",
    "impaye_echu": "facturation",
    "chantier_termine": "apres",
    "rendez_vous_a_poser": "operations",
    "page_du_matin": "direction"
  },
  "departements": [
    "accueil",
    "devis",
    "suivi",
    "facturation",
    "apres",
    "operations",
    "direction"
  ],
  "lectures": {
    "Lire l'interrupteur général (simulation : épinglé)": {
      "requete": "GET systeme_reglages?select=interrupteur_general,organisation_systeme,passage,maintenant&artisan_id=is.null&limit=1",
      "schema": "interrupteur"
    },
    "Lire les comptes (simulation : épinglé)": {
      "requete": "GET departements_reglages?select=artisan_id,palier,offre,interrupteurs,accueil,empreintes_connues,cles_existantes&artisan_id=in.(<comptes en palier>)&limit=200",
      "schema": "compte"
    },
    "Lire les événements non traités, page par page (simulation : épinglé)": {
      "requete": "GET evenements_a_traiter?select=id,artisan_id,type,cle,demande,donnees&artisan_id=eq.<compte>&traite_le=is.null&order=survenu_le.asc&limit=50&offset=<page>",
      "schema": "page"
    }
  },
  "interrupteur": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "interrupteur_general",
      "organisation_systeme",
      "passage",
      "maintenant"
    ],
    "properties": {
      "interrupteur_general": {
        "type": "boolean"
      },
      "organisation_systeme": {
        "type": "string",
        "format": "uuid"
      },
      "passage": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}T\\d{4}$"
      },
      "maintenant": {
        "type": "string",
        "format": "date-time"
      }
    }
  },
  "compte": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "artisan_id",
      "palier",
      "offre",
      "interrupteurs",
      "accueil",
      "empreintes_connues",
      "cles_existantes"
    ],
    "properties": {
      "artisan_id": {
        "type": "string",
        "format": "uuid"
      },
      "palier": {
        "enum": [
          "simulation",
          "ombre",
          "reel"
        ]
      },
      "offre": {
        "enum": [
          "studio",
          "signature",
          "essentiel",
          "essai"
        ]
      },
      "interrupteurs": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "general",
          "departements"
        ],
        "properties": {
          "general": {
            "type": "boolean"
          },
          "departements": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "accueil",
              "devis",
              "suivi",
              "facturation",
              "apres",
              "operations",
              "direction"
            ],
            "properties": {
              "accueil": {
                "type": "boolean"
              },
              "devis": {
                "type": "boolean"
              },
              "suivi": {
                "type": "boolean"
              },
              "facturation": {
                "type": "boolean"
              },
              "apres": {
                "type": "boolean"
              },
              "operations": {
                "type": "boolean"
              },
              "direction": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "accueil": {
        "type": "object",
        "description": "presti-dep-accueil@1 config, moins interrupteur_general et interrupteur_departement (posés par le Cerveau depuis interrupteurs)"
      },
      "empreintes_connues": {
        "type": "array",
        "maxItems": 1000,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "empreinte",
            "lead_id"
          ],
          "properties": {
            "empreinte": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "lead_id": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "cles_existantes": {
        "type": "array",
        "maxItems": 1000,
        "items": {
          "type": "string",
          "maxLength": 80
        }
      }
    }
  },
  "page": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "artisan_id",
      "page",
      "suivante",
      "evenements"
    ],
    "properties": {
