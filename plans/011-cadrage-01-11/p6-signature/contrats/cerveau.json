                  "type": "string",
                  "format": "date-time"
                },
                "message": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 4000
                },
                "champs": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "canal": {
                      "type": "string",
                      "maxLength": 30,
                      "pattern": "^[a-z_]+$"
                    },
                    "origine": {
                      "type": "string",
                      "maxLength": 30,
                      "pattern": "^[a-z0-9_]+$"
                    },
                    "urgence": {
                      "enum": [
                        "urgent",
                        "normal"
                      ]
                    },
                    "type_chantier": {
                      "type": "string",
                      "maxLength": 60,
                      "pattern": "^[^/@:]+$"
                    },
                    "taille": {
                      "enum": [
                        "1",
                        "2 à 5",
                        "6 à 20",
                        "plus de 20"
                      ]
                    },
                    "activite": {
                      "enum": [
                        "Artisan",
                        "Entreprise du bâtiment",
                        "Architecte",
                        "Autre"
                      ]
                    },
                    "budget_tranche": {
                      "type": "string",
                      "maxLength": 30,
                      "pattern": "^[^/@:]+$"
                    },
                    "delai_souhaite": {
                      "type": "string",
                      "maxLength": 30,
                      "pattern": "^[^/@:]+$"
                    },
                    "surface_m2": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100000
                    },
                    "photo_jointe": {
                      "type": "boolean"
                    },
                    "dans_zone": {
                      "type": "boolean"
                    },
                    "recu_hors_horaires": {
                      "type": "boolean"
                    }
                  }
                },
                "empreinte_contact": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9a-f]{64}$"
                },
                "client_existant": {
                  "type": "boolean"
                },
                "honeypot": {
                  "type": "boolean"
                },
                "photo": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": false,
                  "required": [
                    "ref",
                    "type_mime"
                  ],
                  "properties": {
                    "ref": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9._-]{1,80}$"
                    },
                    "type_mime": {
                      "enum": [
                        "image/jpeg",
                        "image/png",
                        "image/webp",
                        "image/heic"
                      ]
                    }
                  }
                },
                "proposition": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": false,
                  "required": [
                    "canal",
                    "objet",
                    "texte",
                    "outil"
                  ],
                  "properties": {
                    "canal": {
                      "enum": [
                        "email",
                        "sms"
                      ]
                    },
                    "objet": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "maxLength": 120
                    },
                    "texte": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1700
                    },
                    "outil": {
                      "type": "string",
                      "pattern": "^[a-z_]{2,60}$"
                    }
                  }
                },
                "destinataire": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "opposition",
                    "consentement_sms"
                  ],
                  "properties": {
                    "opposition": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    },
                    "consentement_sms": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    }
                  }
                }
              }
            },
            "donnees": {
              "type": "object"
            }
          }
        }
      }
    }
  },
