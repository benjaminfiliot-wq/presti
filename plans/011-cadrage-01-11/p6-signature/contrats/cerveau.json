                "impaye_echu",
                "chantier_termine",
                "rendez_vous_a_poser",
                "page_du_matin"
              ]
            },
            "cle": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60,
              "pattern": "^[A-Za-z0-9_:.-]+$"
            },
            "demande": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "canal",
                "recu_le",
                "message",
                "champs",
                "empreinte_contact",
